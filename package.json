{
  "name": "note-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server that drives note.com entirely through a headless Chromium (login, post, like-by-keyword).",
  "type": "module",
  "bin": {
    "note-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:check": "node dist/cli.js check",
    "test:login": "node dist/cli.js login",
    "test:post": "node dist/cli.js post",
    "test:like": "node dist/cli.js like",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.2",
    "marked": "^14.1.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
